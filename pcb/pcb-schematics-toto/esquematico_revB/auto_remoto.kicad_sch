			)
			(justify left top)
		)
		(uuid "895b88ba-0c4b-4c55-a0c3-30eb557ce586")
	)
	(text "BUS I2C (3,3 V, 400 kHz)"
		(exclude_from_sim no)
		(at 16.5 144.5 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "8999bd26-cee9-4a70-af3c-2fcb0dc2bd13")
	)
	(text "Pack 1 - motores"
		(exclude_from_sim no)
		(at 19 25.4 0)
		(effects
			(font
				(size 1.4 1.4)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "962a522f-d84a-44b1-993f-e338c2223b75")
	)
	(text "3,3 V: los da la EDU-CIAA\n(su regulador NCP1117, 1 A)\npor los pines 3V3 de P1/P2."
		(exclude_from_sim no)
		(at 88.9 111.3 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "97581612-ba05-421c-a6f1-820e091a401f")
	)
	(text "C6/C7 junto al pin 5V (picos de 300-500 mA).\n\nIO13 = RX de la ESP <- TX de la CIAA\nIO14 = TX de la ESP -> RX de la CIAA\nUART 115200, 3,3 V: conexion directa.\nJ5: grabar en la placa (IO0 a GND al reset)."
		(exclude_from_sim no)
		(at 325.12 193.04 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "aabb778d-2c40-4de0-a173-d32fae45328b")
	)
	(text "EDU-CIAA-NXP (poncho)"
		(exclude_from_sim no)
		(at 141.5 19.5 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "acb776e2-40cf-4001-86ac-57dd6b7cbcb8")
	)
	(text "- Rev B segun decisiones al 29/10/2026 (CONTEXTO_AUTO_REMOTO.md).\n- Ningun pin de la CIAA recibe mas de 3,3 V: solo ECHO y las baterias pasan por divisor.\n- GNDA solo para los divisores de bateria (la CIAA une GND y GNDA internamente).\n- Las redes con el mismo nombre de etiqueta estan conectadas entre bloques."
		(exclude_from_sim no)
		(at 16 253 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "b0918912-5f86-459b-a65b-f1d1a012b4b3")
	)
	(text "NOTAS"
		(exclude_from_sim no)
		(at 16 248 0)
		(effects
			(font
				(size 1.4 1.4)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b158810e-7d75-459b-839b-9fd5a5dc543e")
	)
	(text "ALIMENTACION"
		(exclude_from_sim no)
		(at 16.5 19.5 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b2f90150-bf90-498f-b453-848629977c66")
	)
	(text "Divisor ECHO:\n5 V -> 3,3 V"
		(exclude_from_sim no)
		(at 213.36 177.56 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "c26afd10-487d-4f4b-8a4b-3e8891b4fc2c")
	)
	(text "P1/P2 = tiras de la EDU-CIAA. Pines segun firmware/tp1/drivers_auto/inc/pines.h.\nLa CIAA recibe 5 V del bus y entrega 3,3 V (pines 3V3) a los sensores del riel +3V3.\nTOF1/2/3_INT y MPU_INT se rutean: el firmware lee por interrupcion."
		(exclude_from_sim no)
		(at 144 122 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "c3f6f2fe-4adc-4005-83b9-37f9e61de447")
	)
	(text "- Modulos externos (ToF, encoders, HC-SR04, GY-521, L298N): tiras\n  macho para cables dupont. ESP32-CAM sobre la placa.\n- Montaje en 2 pisos: abajo motores, encoders e IMU; arriba la\n  CIAA con el poncho, ToF, HC-SR04, L298N y LM2596.\n- Footprints del LM2596 y la ESP32-CAM: dibujarlos midiendo."
		(exclude_from_sim no)
		(at 150 253 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "e0cc775c-d543-4ce8-a7f6-d207cacfa301")
	)
	(text "Divisor 100k/33k:\n8,4 V -> 2,08 V en CH2"
		(exclude_from_sim no)
		(at 101.6 85.12 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "e2fed99c-e6fd-4aa2-a0c5-64afd86a717d")
	)
	(text "Canal A (OUT1/OUT2) = motores izquierdos\nCanal B (OUT3/OUT4) = motores derechos\n(los 2 motores de cada lado en paralelo)\n\nSacar los jumpers ENA/ENB.\nDejar el jumper 5V del modulo y NO\nconectar su bornera +5V.\n100 nF ceramico en bornes de cada motor."
		(exclude_from_sim no)
		(at 284 72 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "e698e2ce-3ca5-4a52-9eda-13882f06ec17")
	)
	(text "Pull-ups opcionales: los modulos\nya traen. Montar si el bus falla\na 400 kHz (cables largos)."
		(exclude_from_sim no)
		(at 68.58 203.42 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "f06dd62f-4bd4-4a2d-b915-4430982f3cc6")
	)
	(text "ToF en 0x30/0x31/0x32 (asignadas\ncon XSHUT): frente y laterales,\npiso de arriba.\n\nMPU6050 en 0x68 (AD0 a GND),\npiso de abajo, por cable.\n\nLas 4 lineas INT se usan\n(lectura por interrupcion)."
		(exclude_from_sim no)
		(at 99.06 185.42 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "f4d3f544-7d13-4c8e-a17b-86b4b0850a6a")
	)
