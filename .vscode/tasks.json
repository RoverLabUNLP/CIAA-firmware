{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CIAA: compilar",
            "type": "process",
            "command": "make",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
